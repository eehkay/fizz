# Fizz server details.
#
# The easy way is to skip this file and run `fizz setup`, which asks for
# both values and writes the real file for you. To do it by hand instead:
#
#   mkdir -p ~/.config/fizz
#   cp env.example ~/.config/fizz/env
#   chmod 600 ~/.config/fizz/env
#
# then edit the two values below. One setting per line, no spaces around
# the "=" and no quotes needed.

# Where your BlueBubbles Server is. Any of these forms works:
#   http://my-mac:1234                     a name on your network or tailnet
#   http://192.168.1.50:1234               a local IP address
#   https://example.trycloudflare.com      the server's proxy URL
BB_URL=http://my-mac:1234

# The password set in BlueBubbles Server > Settings.
BB_PASSWORD=change-me
